# virtual environments / local config
.venv/
venv/
env/
.env
.env.*

# python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# temporary / editor / OS files
*.tmp
*.log
.vscode/
.idea/
.DS_Store
